#!/usr/bin/env bash
# Builds a ptm workspace binary for linux/amd64 (glibc) inside a Docker container.
# Usage: ./build-linux-glibc [ptm|ptm-sync]   (default: ptm)
# The container runs as the host user's UID:GID so output files are
# owned by the caller. The Cargo registry is cached in a named Docker
# volume (ptm-cargo-cache) across runs.
set -euo pipefail

BINARY="${1:-ptm}"
if [[ "$BINARY" != "ptm" && "$BINARY" != "ptm-sync" && "$BINARY" != "md" ]]; then
  echo "Error: unknown binary '$BINARY'. Valid options: ptm, ptm-sync, md" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="ptm-builder"
CARGO_VOLUME="ptm-cargo-cache"

# Always clean build cache
docker buildx prune -f

echo "==> Building Docker image ($IMAGE)..."
docker build --platform linux/amd64 -t "$IMAGE" "$SCRIPT_DIR"

# Minimum glibc version to link against. Override with e.g.
#   GLIBC_MIN=2.31 ./build-linux-glibc
GLIBC_MIN="${GLIBC_MIN:-2.26}"
TARGET="x86_64-unknown-linux-gnu.${GLIBC_MIN}"

echo "==> Running tests inside container..."
docker run --rm \
  --platform linux/amd64 \
  --user "$(id -u):$(id -g)" \
  --volume "$SCRIPT_DIR:/workspace" \
  --volume "$CARGO_VOLUME:/cargo-cache" \
  "$IMAGE" \
  cargo test --bin "$BINARY"

echo "==> Building $BINARY (release, glibc >= $GLIBC_MIN) inside container..."
docker run --rm \
  --platform linux/amd64 \
  --user "$(id -u):$(id -g)" \
  --volume "$SCRIPT_DIR:/workspace" \
  --volume "$CARGO_VOLUME:/cargo-cache" \
  "$IMAGE" \
  cargo zigbuild --release --bin "$BINARY" --target "$TARGET"

# cargo zigbuild places the binary under the full target triple, then copy it
# to target/release/ for a consistent output location.
SRC="$SCRIPT_DIR/target/x86_64-unknown-linux-gnu/release/$BINARY"
DST="$SCRIPT_DIR/target/release/$BINARY"
mkdir -p "$SCRIPT_DIR/target/release"
cp "$SRC" "$DST"
echo "==> Done: $DST  (linked against glibc >= $GLIBC_MIN)"
